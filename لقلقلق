#include "CrimeBloodlineEconomyNews.h"

ACrimeBloodlineEconomyNews::ACrimeBloodlineEconomyNews()
{
    PrimaryActorTick.bCanEverTick = false;
    MarketState.FoodWaterMultiplier = 1.0f;
    MarketState.FuelMultiplier = 1.0f;
    MarketState.WeaponsAmmoMultiplier = 1.0f;
    MarketState.ContrabandMultiplier = 1.0f;
    MarketState.InflationRate = 0.05f;

    SpyMediaState.ActiveSpiesCount = 2;
    SpyMediaState.IntelNetworkStrength = 25.0f;
    SpyMediaState.LatestHeadline = TEXT("هدوء حذر في الشوارع وتقارير عن تحركات غير معتادة");
    SpyMediaState.bRadioBroadcastActive = true;
    SpyMediaState.bNewspaperEditionPublished = true;
}

void ACrimeBloodlineEconomyNews::RecalculateMarketPrices(bool bRegionalCrisis, bool bGangWarActive)
{
    const float RandomSwing = FMath::FRandRange(0.85f, 1.25f);
    const float CrisisBoost = bRegionalCrisis ? 1.35f : 1.0f;
    const float GangWarBoost = bGangWarActive ? 1.45f : 1.0f;
    const float BaseInflationFactor = 1.0f + MarketState.InflationRate;

    MarketState.FoodWaterMultiplier = FMath::Clamp(RandomSwing * CrisisBoost * BaseInflationFactor, 0.60f, 3.00f);
    MarketState.FuelMultiplier = FMath::Clamp(RandomSwing * CrisisBoost * BaseInflationFactor, 0.65f, 3.20f);
    MarketState.WeaponsAmmoMultiplier = FMath::Clamp(RandomSwing * GangWarBoost * BaseInflationFactor, 0.75f, 3.50f);
    MarketState.ContrabandMultiplier = FMath::Clamp(RandomSwing * GangWarBoost * CrisisBoost * BaseInflationFactor, 0.80f, 4.00f);
}

float ACrimeBloodlineEconomyNews::GetCurrentItemPrice(EMarketGoodType GoodType, float BasePrice) const
{
    const float SafeBase = FMath::Max(0.0f, BasePrice);
    float Multiplier = 1.0f;

    switch (GoodType)
    {
    case EMarketGoodType::FoodAndWater:
        Multiplier = MarketState.FoodWaterMultiplier;
        break;
    case EMarketGoodType::Fuel:
        Multiplier = MarketState.FuelMultiplier;
        break;
    case EMarketGoodType::WeaponsAmmo:
        Multiplier = MarketState.WeaponsAmmoMultiplier;
        break;
    case EMarketGoodType::Contraband:
        Multiplier = MarketState.ContrabandMultiplier;
        break;
    case EMarketGoodType::RealEstate:
        Multiplier = 1.0f + (MarketState.InflationRate * 2.0f);
        break;
    default:
        Multiplier = 1.0f;
        break;
    }

    return SafeBase * Multiplier;
}

void ACrimeBloodlineEconomyNews::DeploySpyAgent(int32 RecruitmentCost)
{
    if (RecruitmentCost < 0)
    {
        return;
    }

    SpyMediaState.ActiveSpiesCount += 1;
    SpyMediaState.IntelNetworkStrength = FMath::Clamp(SpyMediaState.IntelNetworkStrength + 12.0f, 0.0f, 100.0f);
}

void ACrimeBloodlineEconomyNews::GatherSpyIntelligenceAndPublishNews(const FString& EventSummary)
{
    const float SpyBonus = SpyMediaState.ActiveSpiesCount * 2.5f;
    SpyMediaState.IntelNetworkStrength = FMath::Clamp(SpyMediaState.IntelNetworkStrength + SpyBonus, 0.0f, 100.0f);

    if (!EventSummary.IsEmpty())
    {
        SpyMediaState.LatestHeadline = EventSummary;
    }
    else
    {
        SpyMediaState.LatestHeadline = TEXT("نشرة عاجلة: تغيرات جديدة في موازين القوى والأسواق");
    }

    SpyMediaState.bRadioBroadcastActive = true;
    SpyMediaState.bNewspaperEditionPublished = true;
}
