    virtual void BeginPlay() override;
    virtual void Tick(float DeltaTime) override;

    // اختيار الشخصية (قاتل مأجور أو عضو عصابة أو شخصية البنت)
    UFUNCTION(BlueprintCallable, Category = "CrimeBloodline|Character")
    void SelectHitmanCharacter();

    UFUNCTION(BlueprintCallable, Category = "CrimeBloodline|Character")
    void SelectFemaleOperativeCharacter();

    UFUNCTION(BlueprintCallable, Category = "CrimeBloodline|Character")
    void SelectGangMemberCharacter(FString CustomName = TEXT("عضو جديد"));

