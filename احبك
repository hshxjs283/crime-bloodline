    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "CrimeBloodline|State")
    EGameMapRegion CurrentRegion = EGameMapRegion::Russia;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "CrimeBloodline|State")
    FCharacterPhysicalProfile CurrentProfile;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "CrimeBloodline|State")
    FSurvivalVitals CurrentVitals;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "CrimeBloodline|Economy")
    float PlayerCash = 500.0f;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "CrimeBloodline|Economy")
    int32 PlayerReputation = 0;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "CrimeBloodline|SaveLoad")
    FString SaveSlot = TEXT("CrimeBloodline_Save_01");

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "CrimeBloodline|SaveLoad")
