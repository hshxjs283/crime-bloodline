#include "CrimeBloodlineSystem.h"
#include "Kismet/GameplayStatics.h"

ACrimeBloodlineSystem::ACrimeBloodlineSystem()
{
    PrimaryActorTick.bCanEverTick = true;
    SelectHitmanCharacter();
}

void ACrimeBloodlineSystem::BeginPlay()
{
    Super::BeginPlay();

    if (!LoadGameProgress())
    {
        SelectHitmanCharacter();
        SaveGameProgress();
    }
}

void ACrimeBloodlineSystem::Tick(float DeltaTime)
{
    Super::Tick(DeltaTime);

    UpdateRealismVitals(DeltaTime);

    AutoSaveTimer += DeltaTime;
    if (AutoSaveTimer >= AutoSaveIntervalSeconds)
    {
        AutoSaveTimer = 0.0f;
        SaveGameProgress();
    }
}

void ACrimeBloodlineSystem::SelectHitmanCharacter()
{
    CurrentArchetype = EPlayerArchetype::Hitman;
    CurrentRegion = EGameMapRegion::Russia;

    CurrentProfile.CharacterName = TEXT("القاتل المأجور");
    CurrentProfile.HeightCm = 200.0f;
    CurrentProfile.WeightKg = 115.0f;
    CurrentProfile.BuildType = TEXT("Muscular Heavy");
    CurrentProfile.SkinTone = TEXT("Clear Dark Tan / Brown");
    CurrentProfile.FacialFeatures = TEXT("Sharp angular face, hollow cheekbones, intense gaze");
    CurrentProfile.OutfitStyle = TEXT("Matte Black Leather Jacket, Black Coat, Shirt, Trousers & Boots");

    const float ScaleRatio = CurrentProfile.HeightCm / 180.0f;
    SetActorScale3D(FVector(ScaleRatio, ScaleRatio * 1.08f, ScaleRatio));
}

